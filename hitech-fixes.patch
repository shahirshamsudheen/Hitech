diff --git a/components/HeaderMobileNav.tsx b/components/HeaderMobileNav.tsx
new file mode 100644
index 0000000..cc410d6
--- /dev/null
+++ b/components/HeaderMobileNav.tsx
@@ -0,0 +1,84 @@
+'use client';
+
+import Link from 'next/link';
+import { Phone, Smartphone } from 'lucide-react';
+import { NAV_ITEMS } from '@/data/navigation';
+import { PHONES } from '@/data/business';
+import styles from './Header.module.css';
+
+interface Props {
+  open: boolean;
+  pathname: string;
+  expanded: string | null;
+  onToggleExpand: (label: string) => void;
+  onClose: () => void;
+}
+
+export default function HeaderMobileNav({
+  open,
+  pathname,
+  expanded,
+  onToggleExpand,
+  onClose,
+}: Props) {
+  return (
+    <nav
+      id="mobile-menu"
+      className={`${styles.mobileMenu} ${open ? styles.open : ''}`}
+      aria-label="Mobile navigation"
+    >
+      {NAV_ITEMS.map((item) => (
+        <div key={item.label} className={styles.mobileNavGroup}>
+          <div className={styles.mobileNavHeader}>
+            <Link
+              href={item.href}
+              className={`${styles.mobileNavLink} ${pathname.startsWith(item.href) ? styles.active : ''}`}
+              onClick={onClose}
+            >
+              {item.label}
+            </Link>
+            {item.children && (
+              <button
+                className={`${styles.mobileExpandBtn} ${expanded === item.label ? styles.expanded : ''}`}
+                onClick={() => onToggleExpand(item.label)}
+                aria-expanded={expanded === item.label}
+                aria-label={`Expand ${item.label}`}
+              >
+                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true">
+                  <path d="M3 4.5L6 7.5L9 4.5" />
+                </svg>
+              </button>
+            )}
+          </div>
+
+          {item.children && expanded === item.label && (
+            <div className={styles.mobileSubMenu}>
+              {item.children.map((child) => (
+                <Link
+                  key={child.label}
+                  href={child.href}
+                  className={styles.mobileSubLink}
+                  onClick={onClose}
+                >
+                  {child.label}
+                </Link>
+              ))}
+            </div>
+          )}
+        </div>
+      ))}
+
+      <div className={styles.mobileActions}>
+        {PHONES.map((phone) => {
+          const Icon = phone.kind === 'landline' ? Phone : Smartphone;
+          return (
+            <a key={phone.tel} href={`tel:${phone.tel}`} className={styles.mobilePhoneLink}>
+              <Icon size={16} strokeWidth={2} aria-hidden="true" />
+              <span>{phone.display}</span>
+            </a>
+          );
+        })}
+      </div>
+    </nav>
+  );
+}
