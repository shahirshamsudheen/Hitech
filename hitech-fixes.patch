+/**
+ * Site navigation, built from the shared service lists in data/services.ts.
+ *
+ * Every dropdown link is generated from the same array the target page
+ * renders, so a dropdown entry can no longer point at a service key that does
+ * not exist on the page.
+ */
+
+import {
+  REPAIR_SERVICES,
+  SECURITY_SERVICES,
+  TRAVEL_SERVICES,
+  EGOV_SERVICES,
+  PRODUCT_CATEGORIES,
+  type ServiceItem,
+} from './services';
+
+export interface NavItem {
+  label: string;
+  href: string;
+  children?: { label: string; href: string }[];
+}
+
+/** Shorter dropdown labels where the card heading is too long for a menu. */
+const NAV_LABEL_OVERRIDES: Record<string, string> = {
+  'motherboard': 'Motherboard & Chip-Level Repair',
+  'os-software': 'Operating System & Software',
+  'on-site': 'On-Site Service',
+  'passport-police': 'Passport & Police Certificates',
+  'certificate-attestation': 'Certificate Attestation',
+  'university': 'University Admissions & Fees',
+  'visa-gcc': 'Visa — GCC Countries',
+  'visa-schengen': 'Visa — Schengen & EU',
+  'visa-usa': 'Visa — USA & Australia',
+};
+
+function toNavChildren(basePath: string, items: ServiceItem[]) {
+  return items.map(item => ({
+    label: NAV_LABEL_OVERRIDES[item.key] ?? item.heading,
+    href: `${basePath}?service=${item.key}`,
+  }));
+}
+
+export const NAV_ITEMS: NavItem[] = [
+  {
+    label: 'Services',
+    href: '/service',
+    children: toNavChildren('/service', REPAIR_SERVICES),
