diff --git a/components/FormConfirmation.tsx b/components/FormConfirmation.tsx
new file mode 100644
index 0000000..ecc7e50
--- /dev/null
+++ b/components/FormConfirmation.tsx
@@ -0,0 +1,58 @@
+'use client';
+
+import { CheckCircleIcon, WhatsAppIcon } from './BrandIcons';
+
+/**
+ * Every enquiry form generated a reference number with generateReference()
+ * and then never rendered it, so the user was given nothing to quote back.
+ * This is the shared confirmation panel that fixes that.
+ *
+ * It also states the delivery channel honestly: the site has no backend, so
+ * WhatsApp is the only route a submission can actually reach Hitech by.
+ */
+
+interface Props {
+  /** The page's CSS module, which supplies the confirmation classes. */
+  styles: Record<string, string>;
+  reference: string;
+  heading: string;
+  mobile?: string;
+  whatsappUrl: string;
+  /** True when the WhatsApp window was opened automatically on submit. */
+  autoOpened?: boolean;
+}
+
+export default function FormConfirmation({
+  styles,
+  reference,
+  heading,
+  mobile,
+  whatsappUrl,
+  autoOpened = false,
+}: Props) {
+  return (
+    <div className={styles.confirmation}>
+      <CheckCircleIcon size={48} className={styles.confirmIcon} />
+      <h1 className={styles.confirmHeading}>{heading}</h1>
+      <p className={styles.referenceNumber}>{reference}</p>
+      <p className={styles.confirmText}>
+        Quote this reference when you contact us.
+        {mobile ? ` We will call you on ${mobile} within one working day.` : ''}
+      </p>
+      <p className={styles.confirmText}>
+        {autoOpened
+          ? 'If WhatsApp did not open, use the button below to send your details.'
+          : 'Send your details on WhatsApp so we have them on record.'}
+      </p>
+      <a
+        href={whatsappUrl}
+        target="_blank"
+        rel="noopener noreferrer"
+        className="btn btn-whatsapp"
+      >
+        <WhatsAppIcon size={20} />
+        Send details on WhatsApp
+      </a>
+    </div>
+  );
+}
