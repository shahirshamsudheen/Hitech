+ */
+const BGA_FEATURES = [
+  {
+    title: 'Ball Grid Array (BGA) Rework Station',
+    desc: 'Precision infrared and hot-air rework station for safely desoldering, reballing and re-soldering micro-pitch ICs.',
+  },
+  {
+    title: 'Component-Level Motherboard Diagnostics',
+    desc: 'Schematic tracing, short-circuit thermal imaging and oscilloscopes to pinpoint failed capacitors, MOSFETs and power controllers.',
+  },
+  {
+    title: 'GPU, CPU & Chipset Micro-Soldering',
+    desc: 'Reviving graphics chips, processor rails, BIOS corruption and power management units instead of costly full board replacements.',
+  },
+  {
+    title: `Board-Level Repair Since ${BUSINESS.boardRepairSince}`,
+    desc: 'A dedicated micro-soldering and board repair bench in Kallara, serving customers and trade clients across the Trivandrum region.',
+  },
