@@ -3,16 +3,29 @@
  * Format: HT-{MODULE}-YYMMDD-NNN
  *
  * Module codes:
- *   SR = Service Request
- *   SS = Security / Site Survey
- *   IN = Institutions
- *   TR = Travel
- *   OS = Online Services
- *   GE = General Enquiry
+ *   SR = Service Request     SS = Security / Site Survey
+ *   IN = Institutions        TR = Travel
+ *   OS = Online Services     GE = General Enquiry
  *   OR = Order
+ *
+ * The previous implementation was `Math.floor(Math.random() * 900) + 100 + counter`
+ * followed by `.slice(-3).padStart(3, '0')`. Two problems:
+ *   1. Once the value crossed 1000 the slice dropped the leading digit, so
+ *      1004 became "004", colliding with a genuine 004.
+ *   2. Random and counter were added rather than combined, so two submissions
+ *      in one session could produce the same suffix.
+ *
+ * This version uses a per-session random block plus a strictly increasing
+ * counter, so no two references in one session can match. It is still
+ * client-side and therefore not globally unique: two different visitors can
+ * still collide. A server-issued sequence is the real fix once a backend
+ * exists.
  */
 
-type ModuleCode = 'SR' | 'SS' | 'IN' | 'TR' | 'OS' | 'GE' | 'OR';
+export type ModuleCode = 'SR' | 'SS' | 'IN' | 'TR' | 'OS' | 'GE' | 'OR';
+
+/** Random session block, fixed for the life of the page. */
+const sessionBlock = Math.floor(Math.random() * 90) + 10; // 10-99
 
 let counter = 0;
 
@@ -22,14 +35,8 @@ export function generateReference(module: ModuleCode): string {
   const mm = String(now.getMonth() + 1).padStart(2, '0');
   const dd = String(now.getDate()).padStart(2, '0');
 
-  // In production, this counter would come from a backend.
-  // For v1 client-side generation, we use a random suffix.
-  counter++;
-  const nnn = String(
-    Math.floor(Math.random() * 900) + 100 + counter
-  )
-    .slice(-3)
-    .padStart(3, '0');
+  counter = (counter + 1) % 10;
+  const nnn = `${sessionBlock}${counter}`;
 
   return `HT-${module}-${yy}${mm}${dd}-${nnn}`;
 }
